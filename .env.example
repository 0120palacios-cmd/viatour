NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORTAL_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Verify miviatour.com in Resend; portal OTP uses no-reply@miviatour.com and support notifications use the support address.
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry: optional. Leave both blank for a no-op local build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Travel-requirements provider. Keep the key server-side; never prefix it with NEXT_PUBLIC_.
RAPIDAPI_VISA_KEY=
# Optional: offline, travelbuddy, or future sherpa. Blank selects Travel Buddy when the key exists, otherwise offline.
REQUIREMENTS_PROVIDER=

# GA4: Measurement ID (G-...) from Admin > Data streams > Web. Consent-gated.
NEXT_PUBLIC_GA4_ID=
# Meta Events Manager: Pixel ID. Consent-gated.
NEXT_PUBLIC_META_PIXEL_ID=
# Search Console: HTML tag verification content value (not the whole tag).
NEXT_PUBLIC_GSC_VERIFICATION=
# Reserved for a future TikTok Events Manager pixel; inactive TODO.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Daily owner digest and automations (/api/cron/daily, scheduled in vercel.json). At least 16 characters;
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Blank disables the route (401).
CRON_SECRET=
# Opt-in automations, off unless set to 1 (customer email copy pending approval, docs/copy-pending.md).
AUTO_REVIEW_INVITES=
CUSTOMER_REMINDERS=
# Optional: delete portal documents this many days after the trip ends (minimum 30). Blank disables.
DOC_RETENTION_DAYS=

# Travel operations (server only). TRAVEL_DATA_KEY: 64 hex characters (32 random bytes) that encrypt private
# traveller data; back it up securely and never regenerate it on deploy. TRAVEL_EMAIL_ENABLED=true is required
# for any itinerary or receipt email to a customer (each send still needs the admin's explicit confirmation).
TRAVEL_DATA_KEY=
TRAVEL_EMAIL_ENABLED=
# Owner-approved internal addresses for test sends, comma-separated. Blank disables test sends.
TRAVEL_TEST_RECIPIENTS=
# true emails the customer a short notice (no message text) when the agency replies in a reservation conversation.
PORTAL_MESSAGE_EMAILS=
